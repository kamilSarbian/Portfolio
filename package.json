{
  "name": "portfolio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:json": "node scripts/check-json.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:unused": "node scripts/check-unused-i18n.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:frontend": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "test:backend": "python -m pytest -q",
    "check": "npm run lint && npm run check:json && npm run check:i18n && npm run check:i18n:unused && npm run check:seo && npm run check:links && npm run check:secrets && npm run test:frontend && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "i18next": "^25.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.5"
  }
}
